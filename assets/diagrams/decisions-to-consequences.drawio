        </mxCell>
        <mxCell id="indicators" value="Indicators&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;5 scores, 0 to 100&lt;/font&gt;" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;fillColor=#E1EBF8;strokeColor=#2F6DB5;fontColor=#0B2540;fontStyle=1;fontSize=15;fontFamily=Figtree;" vertex="1" parent="1">
          <mxGeometry x="510" y="75" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="explanations" value="Explanations&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Who gains, who loses&lt;/font&gt;" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;fillColor=#0B2540;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Figtree;" vertex="1" parent="1">
