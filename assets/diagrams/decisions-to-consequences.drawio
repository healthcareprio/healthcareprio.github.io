<mxfile host="app.diagrams.net">
  <diagram id="decisions-to-consequences" name="Decisions to consequences">
    <mxGraphModel dx="900" dy="230" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="230" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="decisions" value="Decisions&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;5 user choices&lt;/font&gt;" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;fillColor=#E3F2F2;strokeColor=#0F7F8C;fontColor=#0B2540;fontStyle=1;fontSize=15;fontFamily=Figtree;" vertex="1" parent="1">
          <mxGeometry x="10" y="75" width="170" height="80" as="geometry"/>
